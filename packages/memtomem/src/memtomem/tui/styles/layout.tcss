/* Structure owns geometry, spacing, and scroll ownership. */
#root {
    width: 100%;
    height: 100%;
}

#topbar {
    height: 1;
    width: 100%;
    background: $surface-lowest;
}

.app-title {
    width: 1fr;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.status-item {
    content-align: right middle;
    margin-right: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.environment-status {
    width: 4;
}

.mouse-status {
    width: 12;
}

.clock-status {
    width: 10;
}

#navigation {
    width: 100%;
    height: 1;
    layout: horizontal;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 0;
    background: $surface-lowest;
}

#navigation-title,
#navigation-legend {
    display: none;
}

#navigation .nav-item {
    width: auto;
    min-width: 8;
    padding: 0 1;
}

#shell-content {
    width: 100%;
    height: 1fr;
}

.section-panel {
    height: 100%;
    border: solid $outline;
    padding: 0 1;
}

#main {
    width: 1fr;
}

#detail {
    width: 38;
}

#safe-floor {
    width: 100%;
    height: 1fr;
    align: center middle;
    display: none;
}

ModalScreen {
    align: center middle;
}

.modal-dialog {
    width: 72;
    max-width: 92%;
    max-height: 100%;
    padding: 0 1;
    border: double $outline;
    background: $surface-high;
}

.help-dialog {
    height: 28;
    min-height: 8;
    max-height: 86%;
}

.confirmation-dialog,
.warning-dialog {
    width: 58;
    height: auto;
}

.modal-title {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.modal-body {
    height: auto;
}

.help-dialog .modal-body {
    height: 1fr;
}

.confirmation-dialog .modal-body {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.modal-actions {
    height: 3;
    align-horizontal: right;
}

/* Shared form, table, preview, and state geometry. */
.form-row {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.form-row-line {
    width: 100%;
    height: auto;
    min-height: 3;
}

.form-label {
    width: 20;
    height: 3;
    padding: 1 1 0 0;
    text-wrap: wrap;
}

.form-control {
    width: 1fr;
    height: auto;
}

.form-message {
    width: 100%;
    height: auto;
    padding-left: 20;
}

.action-bar {
    width: 100%;
    height: 3;
    margin-top: 1;
    align-horizontal: right;
}

.data-table-view,
.data-table {
    width: 100%;
    height: 1fr;
    min-height: 3;
}

.preview-block,
.confirmation-block,
.empty-state,
.error-state,
.operation-state,
.notice-block {
    width: 100%;
    height: auto;
    padding: 1;
}

.preview-block,
.confirmation-block {
    margin-bottom: 1;
}

.preview-title,
.empty-state-title,
.error-state-title,
.confirmation-status,
.modal-status {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.preview-summary,
.confirmation-message,
.confirmation-instruction,
.empty-state-message,
.error-state-message,
.error-state-recovery,
.notice-message,
.notice-recovery {
    width: 100%;
    height: auto;
    text-wrap: wrap;
}

.operation-state-message,
.operation-state-counts,
.operation-state-recovery {
    width: 100%;
    height: auto;
    text-wrap: wrap;
}

.operation-state-title {
    height: 1;
    text-wrap: nowrap;
}

.operation-state-message,
.operation-state-counts {
    margin-bottom: 1;
}

.preview-summary,
.confirmation-message,
.confirmation-instruction,
.error-state-recovery,
.notice-recovery {
    margin-bottom: 1;
}

/* Persistent route surfaces and dense operational content. */
.route-surface {
    width: 100%;
    height: 100%;
    padding: 1;
}

.inline-notice,
.status-list,
.notice-stack,
.feedback-stack,
.detail-stack {
    width: 100%;
    height: auto;
}

.status-row {
    width: 100%;
    height: auto;
    min-height: 2;
    layout: horizontal;
    padding: 0 1;
}

.status-label {
    width: 14;
    height: auto;
}

.status-value {
    width: 22;
    height: auto;
    text-wrap: wrap;
}

.status-note {
    width: 1fr;
    height: auto;
    text-wrap: wrap;
    text-overflow: fold;
}

.filter-grid {
    width: 100%;
    height: auto;
}

.filter-column {
    width: 1fr;
    height: auto;
}

.compact-form-row .form-label {
    width: 12;
}

.compact-form-row .form-message {
    padding-left: 12;
}

.result-summary,
.detail-copy,
.detail-heading,
.metadata-row,
.memory-content {
    width: 100%;
    height: auto;
    text-wrap: wrap;
    text-overflow: fold;
}

.result-summary {
    min-height: 1;
    margin: 1 0;
}

.result-table-view {
    width: 100%;
    height: 12;
    min-height: 5;
}

.detail-heading {
    height: 1;
    margin-top: 1;
}

.memory-content {
    min-height: 3;
    padding: 1;
}

.metadata-row {
    padding: 0 1;
}

.preview-item,
.fingerprint-row {
    width: 100%;
    height: auto;
    min-height: 1;
}

.preview-item-label,
.fingerprint-label {
    width: 20;
    height: auto;
    padding-right: 1;
    text-wrap: wrap;
}

.preview-item-value,
.fingerprint-value {
    width: 1fr;
    height: auto;
    text-wrap: wrap;
    text-overflow: fold;
}

.confirmation-phrase {
    width: 100%;
    height: auto;
    min-height: 1;
    padding: 0 1;
    margin-bottom: 1;
    text-wrap: wrap;
    text-overflow: fold;
}

.confirmation-input {
    width: 100%;
}

.preview-confirm-dialog {
    width: 76;
    height: 30;
    max-width: 94%;
    max-height: 92%;
}

.preview-confirm-body {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
}

.preview-confirm-compact .preview-confirm-dialog {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    padding: 0;
}

.preview-confirm-compact .preview-confirm-body {
    height: 1fr;
    min-height: 1;
}

.preview-confirm-compact .action-bar {
    height: 3;
    margin-top: 0;
}

.preview-confirm-compact .confirmation-input {
    height: 1;
    min-height: 1;
    padding: 0;
    border: none;
}
