/* Reusable component appearance. */
.section-title,
.modal-title {
    text-style: bold;
    color: $text;
}

.nav-item {
    width: 100%;
    height: 1;
    color: $text;
}

.nav-item:disabled {
    color: $muted;
}

.readiness-line {
    margin-top: 1;
}

Button {
    min-width: 12;
    height: 3;
    margin: 0 1 0 0;
    border: none;
    background: $surface-highest;
    color: $text;
}

Button.choice-button {
    min-width: 9;
    margin: 0 0 0 1;
}

.task-center {
    width: 100%;
    height: 100%;
}

.task-row {
    width: 100%;
    height: auto;
    padding: 1 0;
    border-bottom: solid $outline;
}

.error-banner {
    width: 100%;
    height: auto;
    max-height: 3;
    padding: 0 1;
    border-left: thick $red;
    color: $red;
    overflow-y: auto;
}

.supporting-text {
    height: auto;
    margin-top: 1;
}

/* Shared form, table, preview, confirmation, and state appearance. */
.form-label,
.preview-title,
.empty-state-title,
.error-state-title,
.operation-state-title,
.confirmation-status {
    text-style: bold;
}

.preview-item-label,
.fingerprint-label,
.form-support {
    color: $muted;
}

.data-table {
    background: $surface-low;
    color: $text;
}

.data-table > .datatable--header {
    background: $surface-high;
    color: $text;
    text-style: bold;
}

.preview-block,
.confirmation-block,
.empty-state,
.error-state,
.operation-state,
.notice-block {
    border: solid $outline;
    background: $surface-low;
}

.notice-title,
.status-value,
.detail-heading {
    text-style: bold;
}

.notice-recovery,
.status-label {
    color: $muted;
}

.status-row {
    border-bottom: solid $outline;
}

.memory-content {
    border: solid $outline;
    background: $surface-lowest;
}

.operation-state-counts {
    color: $muted;
}

.confirmation-phrase {
    background: $surface-highest;
    text-style: bold;
}

.text-input {
    border: solid $outline;
    background: $surface-lowest;
    color: $text;
}

Footer {
    height: 1;
    background: $surface-lowest;
}
