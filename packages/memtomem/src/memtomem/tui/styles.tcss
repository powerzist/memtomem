/* Reusable layers: structure -> component -> role/variant -> color -> state. */

Screen {
    background: #0d141c;
    color: #d8dee9;
}

/* Modal family */
KeybindingsScreen,
ConhostWarningScreen,
QuitConfirmScreen {
    align: center middle;
}

.modal-dialog {
    max-width: 90%;
    max-height: 90%;
    border: solid #45e0ff;
    background: #0d141c;
    padding: 1 2;
}

.modal-dialog.modal-wide {
    width: 76;
}

.modal-dialog.modal-compact {
    width: 50;
}

.modal-dialog.warning {
    border: solid #f2c94c;
}

.modal-dialog.ascii-border {
    border: ascii #45e0ff;
}

.modal-dialog.warning.ascii-border {
    border: ascii #f2c94c;
}

.modal-title {
    color: #45e0ff;
    text-style: bold;
    margin-bottom: 1;
}

.modal-dialog.warning > .modal-title {
    color: #f2c94c;
}

.modal-body {
    margin-bottom: 1;
}

.modal-body-scroll {
    height: 1fr;
    overflow-y: auto;
    margin-bottom: 1;
}

.modal-actions {
    height: auto;
}

/* Diagnostics family */
.diagnostic-screen {
    height: 1fr;
    padding: 1;
}

.diagnostic-title {
    margin-bottom: 1;
}

.diagnostic-input {
    margin: 1 0;
}

/* Application layout skeleton */
#root {
    height: 100%;
    padding: 1 2;
}

#layout {
    height: 1fr;
}

#footer-spacer {
    height: 0;
    display: none;
}

.topbar {
    height: 1;
    layout: horizontal;
    margin: 0 1 1 1;
}

.app-title {
    width: 1fr;
    color: #45e0ff;
    text-style: bold;
}

.status-item {
    content-align: right middle;
    color: #8b9aad;
    margin-right: 1;
}

.environment-status {
    width: 4;
}

.clock-status {
    width: 10;
}

.mouse-status {
    width: 12;
}

.menu-bar {
    height: 1;
    layout: horizontal;
    margin: 0 1 1 1;
    overflow-x: auto;
    overflow-y: hidden;
}

.menu-bar.active-panel {
    background: #101d28;
}

MenuItem.menu-item {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 1;
    content-align: center middle;
    color: #d8dee9;
}

/* Section family */
.section-panel {
    border: solid #233242;
    padding: 1;
}

.main-section {
    width: 1fr;
    margin-right: 1;
    padding: 1 2;
}

.detail-section {
    width: 34;
}

.section-body {
    height: 1fr;
    overflow-y: auto;
    padding-right: 1;
}

.section-panel.active-panel {
    border: solid #45e0ff;
}

.section-panel.ascii-border {
    border: ascii #233242;
}

.section-panel.ascii-border.active-panel {
    border: ascii #45e0ff;
}

/* Titles and semantic status text */
.title {
    color: #45e0ff;
    text-style: bold;
    margin-bottom: 1;
}

.muted {
    color: #8b9aad;
}

.warning {
    color: #ffd166;
    text-style: bold;
}

.ok {
    color: #4ade80;
    text-style: bold;
}

.error {
    color: #ff6b6b;
    text-style: bold;
}

/* Shared focus state */
.inactive-panel-focus {
    outline: tall #2f5f75;
}

.active-panel-focus {
    outline: tall #45e0ff;
}

MenuItem.inactive-panel-focus {
    background: #123447;
    color: #d8dee9;
    outline: none;
}

MenuItem.active-panel-focus {
    background: #45e0ff;
    color: #0d141c;
    text-style: bold;
    outline: none;
}

/* Inputs, lists, and tabs */
.text-input {
    width: 1fr;
}

.search-input {
    margin-bottom: 1;
}

ListView.data-list,
SelectionList.data-list {
    height: auto;
    max-height: 100%;
}

ListView.data-list.remaining-space-list,
SelectionList.data-list.remaining-space-list {
    height: 1fr;
    min-height: 1;
}

.result-list {
    margin-top: 1;
}

.tab-bar {
    margin-bottom: 1;
}

/* Logs */
.log-panel {
    height: 1fr;
    border: solid #1d2a37;
    padding: 1;
}

.log-panel.ascii-border {
    border: ascii #1d2a37;
}

.index-log {
    margin-top: 1;
}

/* Compact controls and settings */
.compact-toolbar {
    height: 1;
    margin: 0 0 1 0;
}

.compact-control {
    width: 3;
    height: 1;
    padding: 0;
    content-align: center middle;
    color: #ffffff;
    background: #123447;
    text-style: bold;
}

.selection-action {
    margin-right: 1;
}

.compact-control:focus {
    background: #45e0ff;
    color: #0d141c;
}

.compact-control.active-panel-focus,
.compact-control.inactive-panel-focus {
    outline: none;
}

.settings-list {
    margin-top: 1;
}

.setting-row-layout {
    height: 1;
    layout: horizontal;
}

.setting-row {
    width: 1fr;
    height: 1;
    padding: 0 1;
}

.setting-row.active-nav {
    background: #123447;
    color: #ffffff;
    text-style: bold;
}

.setting-row.editing-setting {
    background: #1d4d35;
    color: #ffffff;
    text-style: bold;
}

.setting-row.active-panel-focus,
.setting-row.inactive-panel-focus {
    outline: none;
}

.setting-value {
    width: 3;
    height: 1;
    content-align: center middle;
}

.setting-value.editing-setting {
    background: #45e0ff;
    color: #0d141c;
    text-style: bold;
}

/* Button family: base -> role -> palette -> state. */
Button {
    margin-top: 1;
    margin-right: 1;
    color: #ffffff;
    text-style: none;
    border: tall #0d141c;
}

Button:hover {
    border: tall #69737b;
}

Button.action-button,
Button.choice-button {
    width: auto;
}

Button.cyan {
    background: #005f5f;
}

Button.blue {
    background: #3b78ff;
}

Button.green {
    background: #13a10e;
}

Button.red {
    background: #e74856;
}

Button.yellow {
    background: #c19c00;
}

ModalButton:focus {
    outline: tall #45e0ff;
}
