/* Structure owns geometry, spacing, and scroll ownership. */
#root {
    width: 100%;
    height: 100%;
}

#topbar {
    height: 1;
    width: 100%;
    background: $surface-lowest;
}

.app-title {
    width: 1fr;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.status-item {
    content-align: right middle;
    margin-right: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.environment-status {
    width: 4;
}

.mouse-status {
    width: 12;
}

.clock-status {
    width: 10;
}

#navigation {
    width: 100%;
    height: 1;
    layout: horizontal;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 0;
    background: $surface-lowest;
}

#navigation-title,
#navigation-legend {
    display: none;
}

#navigation .nav-item {
    width: auto;
    min-width: 8;
    padding: 0 1;
}

#shell-content {
    width: 100%;
    height: 1fr;
}

.section-panel {
    height: 100%;
    border: solid $outline;
    padding: 0 1;
}

#main {
    width: 1fr;
}

#detail {
    width: 38;
}

#safe-floor {
    width: 100%;
    height: 1fr;
    align: center middle;
    display: none;
}

ModalScreen {
    align: center middle;
}

.modal-dialog {
    width: 72;
    max-width: 92%;
    max-height: 100%;
    padding: 0 1;
    border: double $outline;
    background: $surface-high;
}

.help-dialog {
    height: 28;
    min-height: 8;
    max-height: 86%;
}

.confirmation-dialog,
.warning-dialog {
    width: 58;
    height: auto;
}

.modal-title {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.modal-body {
    height: auto;
}

.help-dialog .modal-body {
    height: 1fr;
}

.confirmation-dialog .modal-body {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.modal-actions {
    height: 3;
    align-horizontal: right;
}
